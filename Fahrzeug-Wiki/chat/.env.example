# Kopiere diese Datei nach chat/.env und trage deinen Key ein.
# chat/.env wird vom Server nie ausgeliefert. Achtung: Der Ordner liegt in OneDrive und wird synchronisiert.

# API-Key aus app.anymize.ai -> Einstellungen -> API-Keys
ANYMIZE_API_KEY=

# Endpunkt: normal oder mit eingebauter Anonymisierung
ANYMIZE_BASE_URL=https://app.anymize.ai/api/v1/llm
# ANYMIZE_BASE_URL=https://app.anymize.ai/api/v1/llm-anonymous

# Modell (Liste: http://localhost:8765/api/models)
ANYMIZE_MODEL=fountain-1.0

# Server
FW_PORT=8765
FW_HOST=127.0.0.1
# Andere Websites, die das Widget einbetten dürfen (kommagetrennt)
FW_ALLOWED_ORIGINS=
